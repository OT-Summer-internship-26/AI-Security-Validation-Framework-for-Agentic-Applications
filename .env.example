# ==============================================================
# .env.example — Template des variables d'environnement
# Copier en `.env` et renseigner les valeurs réelles. NE PAS committer .env.
# ==============================================================

# ---- LLM ----
OPENAI_API_KEY=sk-...

# ---- LLM-as-Judge (DeepTeam / PyRIT) — profil actif ----
# dev   = Ollama local qwen2.5:7b (gratuit, attaques faibles → dev du pipeline)
# final = Gemini Flash (attaques fortes + jugement fiable → audit officiel)
# ci    = DryRunModel (offline, zéro token)
AUDIT_LLM_PROFILE=dev
# Requis UNIQUEMENT pour le profil `final`. Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-...
# (optionnel) surcharger le modèle Gemini — défaut gemini-flash-latest.
# ⚠️ NE PAS mettre gemini-2.0-flash / -flash-lite : quota free-tier = 0 (429 dès le
#    1er appel). L'alias gemini-flash-latest a un quota actif (vérifié 2026-07-26).
# AUDIT_GEMINI_MODEL=gemini-flash-latest
# (optionnel) surcharger le modèle/serveur Ollama du profil dev
# AUDIT_OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Observabilité (LangFuse) ----
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# ---- Framework ----
FRAMEWORK_API_KEY=your-secret-key
LOG_LEVEL=INFO

# ---- Scoring ----
SCORE_THRESHOLD=70          # score minimum pour autoriser un déploiement

# ---- Sandbox (ASI05) ----
SANDBOX_TIMEOUT=5           # secondes
SANDBOX_MEMORY_MB=128
SANDBOX_NETWORK=none

# ---- LangFuse / Docker Compose (Phase 2) ----
NEXTAUTH_SECRET=changeme
SALT=changeme
DATABASE_URL=postgresql://postgres:postgres@db:5432/langfuse

# --- Ports publies par docker compose --------------------------------------
# Changer si un service occupe deja ces ports sur la machine hote.
API_PORT=8000
DASHBOARD_PORT=8080

# --- Coeurs alloues a l'ouvrier ---------------------------------------------
# `cpus` est la SEULE limite que Docker refuse a la CREATION si la machine n'a
# pas autant de coeurs : « range of CPUs is from 0.01 to 2.00, as there are only
# 2 CPUs available ». Le compose demande 4.0 par defaut — c'est l'ouvrier qui
# porte les modeles — et la pile ne se leve donc pas sur une machine a moins de
# quatre coeurs. Baisser ICI plutot que dans le compose : la valeur de
# production ne change pas.
#
# La CI le fixe a 2.0 (runner GitHub = 2 vCPU). Decommenter si votre machine a
# moins de quatre coeurs.
# AUDIT_WORKER_CPUS=2.0

# --- Ce que cet outil a le droit d'ATTAQUER ----------------------------------
# Liste d'hotes autorises, separes par des virgules. VIDE = aucune restriction.
#
# A DEFINIR EN PRODUCTION. Sans elle, `target_url` n'est borne par rien : un
# operateur authentifie peut viser 169.254.169.254 (metadonnees cloud) ou
# n'importe quelle adresse interne. Et comme les reponses de la cible sont
# enregistrees dans le journal d'echanges puis relisibles par /runs/{id} et le
# dashboard, une cle operateur fuitee devient un SSRF avec exfiltration.
#
# On ne bloque PAS les adresses privees : auditer un service interne qu'on
# POSSEDE est le metier de cet outil. On borne ce qu'une installation donnee a
# le droit d'atteindre.
#
# Un motif commencant par un point couvre les sous-domaines, mais PAS le
# domaine nu : `.interne.exemple.com` n'autorise pas `interne.exemple.com`.
#
#   AUDIT_TARGET_ALLOWLIST=localhost,127.0.0.1,.interne.exemple.com
#
# Laisse vide, l'API emet un avertissement au premier audit — pour qu'une mise
# en production ne reste pas ouverte par simple ignorance.

# --- Sauvegardes -------------------------------------------------------------
# Le volume porte la base d'etat, la file, les CLES D'API (seules leurs
# empreintes sont stockees : une cle perdue ne se retrouve pas) et des heures de
# calcul deja payees. `docker compose down -v` detruit tout, sans confirmation.
#
#   sauvegarde-planifiee.bat                          # a enregistrer une fois
#   python scripts/backup_volume.py --verifier        # la planification tourne-t-elle ?
#
# `--verifier` rend un code non nul si la derniere sauvegarde a plus de 26 h :
# c'est lui qu'il faut brancher sur la supervision. Un script de sauvegarde qui
# existe ne prouve pas qu'il TOURNE.

# --- Deploiement : QUELLE image tourne ---------------------------------------
# Laisser vide en developpement : compose construit localement, comme avant.
#
# EN PRODUCTION, on ne construit pas — on TIRE l'image que la CI a eprouvee.
# Elle est publiee sur GHCR a chaque `push` sur main, etiquetee `sha-<7>` : une
# etiquette IMMUABLE, ce qui rend le retour arriere possible. Avec `latest`,
# celui d'hier n'existe plus, donc on ne revient nulle part.
#
#   AUDIT_IMAGE_API=ghcr.io/<votre-org>/ai-security-framework
#   AUDIT_IMAGE_DASHBOARD=ghcr.io/<votre-org>/ai-security-dashboard
#   AUDIT_VERSION=sha-a1b2c3d
#
# Deployer :           docker compose pull && docker compose up -d --no-build
# Revenir en arriere : remettre l'ancien AUDIT_VERSION, rejouer ces deux lignes.
#
# L'etiquette exacte a poser est affichee en fin de job de publication.

# --- Execution des audits ---------------------------------------------------
# 1 (defaut) : l'API execute elle-meme — mode DEVELOPPEMENT. Un redemarrage tue
#              les audits en cours.
# 0          : l'API depose dans la file, un ouvrier separe execute. EN PRODUCTION.
#              Lancer l'ouvrier : python scripts/worker.py
AUDIT_INLINE_WORKER=1

# Emplacement de la base d'etat (file + cles). Defaut : <AUDIT_DATA_DIR>/state.sqlite
# AUDIT_STATE_DB=/var/lib/ai-security/state.sqlite

# Racine des donnees. TOUT en decoule : resultats, rapports, base d'etat ET
# points de reprise LangGraph. Dans l'image, elle designe le volume persistant.
# AUDIT_DATA_DIR=/var/lib/ai-security

# Points de reprise LangGraph. Defaut : <AUDIT_DATA_DIR>/checkpoints.sqlite.
# NE PAS le sortir de la racine des donnees : reprendre un audit suppose de
# retrouver A LA FOIS le point de reprise et les resultats deja ecrits. Les
# separer fait rejouer des agents dont les resultats existent — c'est ce qui
# arrivait dans l'image, ou le checkpoint tombait sur le disque ephemere.
# AUDIT_CHECKPOINTS=/var/lib/ai-security/checkpoints.sqlite

# Delai au-dela duquel un ouvrier silencieux est presume mort et son travail repris.
AUDIT_WORKER_HEARTBEAT_MAX=900
