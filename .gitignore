# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ---- Environnements virtuels ----
venv/
.venv/
env/
ENV/

# ---- Secrets / config locale ----
.env
*.local

# ---- Logs / artefacts ----
install_log.txt
*.log
/reports/
*.pdf

# ---- Caches d'outils ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.semgrep/

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# Config locale du dashboard (contient la cle d API)
dashboard/.env.local

# ---- Dependances / build front (dashboard + presentation) ----
node_modules/
dist/
.vite/

# Base de reprise LangGraph (etat local, pas un livrable)
data/checkpoints.sqlite*

# --- Artefacts d'execution et d'outillage (regenerables) -------------------
# Ils etaient soit suivis a tort, soit deposes a la racine par un outil.
.coverage
# rapports .jsonl produits par garak a chaque run
runs/
# sorties de bandit / radon / pip-audit
reports/
garak.log
# dossier ne d'un « mkdir -p » interprete par cmd.exe
-p/
# Base d'etat des executions et des cles : elle contient des empreintes de cles
# d'API et l'historique des audits d'un poste. Elle s'est retrouvee commitee une
# fois par un `git add -A` — une base d'EXECUTION n'a rien a faire dans un depot.
data/state.sqlite
data/state.sqlite-wal
data/state.sqlite-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Archives de sauvegarde du volume. Elles contiennent la base d'etat COMPLETE :
# empreintes des cles d'API, file d'attente, et tous les resultats d'audit avec
# les reponses des cibles. Un `git add -A` distrait les publierait.
sauvegardes/

# Cle PRIVEE de signature des images. Chiffree, mais une clé privée chiffrée
# reste une clé privée : elle ne va QUE dans les secrets GitHub, jamais ici.
# `cosign.pub` (la publique), elle, DOIT etre versionnee — c'est elle qui permet
# a quiconque de verifier qu'une image vient bien de cette chaine.
cosign.key
*.key

# --- Outillage local, jamais un livrable ------------------------------------
# Ces trois-la etaient SUIVIS : `.gitignore` n'agit pas sur ce qui l'est deja,
# il a fallu un `git rm --cached`. Ils restent sur le disque, hors du depot.
# liste d'autorisations locale, avec les chemins absolus de CE poste
.outils/
# telemetrie de deepeval
.deepeval/
# doublon racine de presentation/src/App.jsx (886 vs 868 lignes)
presentation.jsx
# deck de projet, deja « materiel hors produit » pour .dockerignore
presentation/

# Les audits `dry_run` sont des fumigenes locaux : reponses simulees, aucune
# cible reelle. Ils n'alimentent pas la demo du dashboard et repoussent a chaque
# execution. Ceux deja commites restent, on arrete juste d'en ajouter.
# `**` et non `*` : `*` ne traverse pas un `/`, les trois dry_run de
# `_archive/` echappaient donc au motif et restaient suivis.
data/audit_results/**/*_dry_run.json
