# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ---- Environnements virtuels ----
venv/
.venv/
env/
ENV/

# ---- Secrets / config locale ----
.env
*.local

# ---- Logs / artefacts ----
install_log.txt
*.log
/reports/
*.pdf

# ---- Caches d'outils ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.semgrep/

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# Config locale du dashboard (contient la cle d API)
dashboard/.env.local

# ---- Dependances / build front (dashboard + presentation) ----
node_modules/
dist/
.vite/

# Base de reprise LangGraph (etat local, pas un livrable)
data/checkpoints.sqlite*

# --- Artefacts d'execution et d'outillage (regenerables) -------------------
# Ils etaient soit suivis a tort, soit deposes a la racine par un outil.
.coverage
runs/                    # rapports .jsonl produits par garak a chaque run
reports/                 # sorties de bandit / radon / pip-audit
garak.log
-p/                      # dossier ne d'un « mkdir -p » interprete par cmd.exe
# Base d'etat des executions et des cles : elle contient des empreintes de cles
# d'API et l'historique des audits d'un poste. Elle s'est retrouvee commitee une
# fois par un `git add -A` — une base d'EXECUTION n'a rien a faire dans un depot.
data/state.sqlite
data/state.sqlite-wal
data/state.sqlite-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Archives de sauvegarde du volume. Elles contiennent la base d'etat COMPLETE :
# empreintes des cles d'API, file d'attente, et tous les resultats d'audit avec
# les reponses des cibles. Un `git add -A` distrait les publierait.
sauvegardes/

# Cle PRIVEE de signature des images. Chiffree, mais une clé privée chiffrée
# reste une clé privée : elle ne va QUE dans les secrets GitHub, jamais ici.
# `cosign.pub` (la publique), elle, DOIT etre versionnee — c'est elle qui permet
# a quiconque de verifier qu'une image vient bien de cette chaine.
cosign.key
*.key
